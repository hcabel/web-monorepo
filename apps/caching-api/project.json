{
  "name": "caching-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/caching-api/src",
  "projectType": "application",
  "tags": [
    "backend"
  ],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/caching-api",
        "webpackConfig": "apps/caching-api/webpack.config.js"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "caching-api:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "caching-api:build:production",
          "inspect": false,
          "watch": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/caching-api/src/**/*"
        ]
      },
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
