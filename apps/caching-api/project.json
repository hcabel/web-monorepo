{
  "name": "caching-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/caching-api/src",
  "projectType": "application",
  "tags": [
    "backend"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/caching-api",
        "configFile": "apps/caching-api/vite.config.mts",
        "outputFileName": "server.js",
        "tsConfig": "apps/caching-api/tsconfig.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "caching-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "caching-api:build:development"
        },
        "production": {
          "buildTarget": "caching-api:build:production",
          "inspect": false,
          "watch": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/caching-api/src/**/*"
        ]
      },
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
