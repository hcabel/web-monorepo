{
  "name": "portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/portfolio",
  "projectType": "application",
  "tags": [
    "frontend"
  ],
  "implicitDependencies": [
    "bridge-caching-api"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/portfolio",
        "configFile": "apps/portfolio/vite.config.mts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "portfolio:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "portfolio:build:development"
        },
        "production": {
          "buildTarget": "portfolio:build:production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "portfolio:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "portfolio:build:development"
        },
        "production": {
          "buildTarget": "portfolio:build:production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "portfolio:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "portfolio:build:development"
        },
        "production": {
          "buildTarget": "portfolio:build:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "pm2 start --name Portfolio pnpm -- nx preview portfolio --configuration production"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/portfolio/pages/**/*",
          "apps/portfolio/components/**/*",
          "apps/portfolio/styles/**/*",
          "apps/portfolio/3D/**/*"
        ]
      },
      "defaultConfiguration": "test",
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
