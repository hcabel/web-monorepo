{
	"presets": ["next/babel"],
	"plugins": [
		[
			"module-resolver",
			{
				"alias": {
					"App": "./apps/frontend/portfolio/app",
					"Components": "./apps/frontend/portfolio/components",
					"3D": "./apps/frontend/portfolio/3D",
					"Images": "./apps/frontend/portfolio/assets/images",
					"Utils": "./apps/frontend/portfolio/utils",
					"@hcabel/bridges/ProjectApi": "./libs/bridges/bridge-project-api/src/index.ts",
					"@hcabel/bridges/TelemetryApi": "./libs/bridges/bridge-telemetry-api/src/index.ts",
					"@hcabel/types/ProjectApi": "./libs/types/types-project-api/src/index.ts",
					"@hcabel/types/TelemetryApi": "./libs/types/types-telemetry-api/src/index.ts"
				}
			}
		],
		"inline-react-svg"
	]
}
