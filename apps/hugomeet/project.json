{
  "name": "hugomeet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hugomeet",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "hugomeet-SS"
  ],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "nextConfig": "apps/hugomeet/next.config.js",
      "options": {
        "root": "apps/hugomeet",
        "outputPath": "dist/apps/hugomeet"
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "hugomeet:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "dev": true
        },
        "production": {
          "buildTarget": "hugomeet:build",
          "dev": false
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "^deploy"
      ],
      "options": {
        "commands": [
          "pm2 startOrReload ecosystem.config.js --only HugoMeet --update-env && pm2 save"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/hugomeet/app/**/*.{ts,tsx,js,jsx}",
          "apps/hugomeet/src/**/*.{ts,tsx,js,jsx}"
        ]
      },
      "defaultConfiguration": "test",
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
