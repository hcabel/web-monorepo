{
  "name": "hugomeet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hugomeet/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "hugomeet-SS"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/hugomeet",
        "configFile": "apps/hugomeet/vite.config.mts",
        "tsConfig": "apps/hugomeet/tsconfig.app.json",
        "skipTypeCheck": true
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "hugomeet:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "hugomeet:build:development"
        },
        "production": {
          "buildTarget": "hugomeet:build:production"
        }
      }
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "hugomeet:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "hugomeet:build:development"
        },
        "production": {
          "buildTarget": "hugomeet:build:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "^deploy"
      ],
      "options": {
        "commands": [
          "pm2 start --name HugoMeet apps/hugomeet/server.js -- 3000"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/hugomeet/src/**/*.{js,jsx,ts,tsx}"
        ],
        "eslintConfig": ".eslintrc.json"
      },
      "defaultConfiguration": "test",
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
