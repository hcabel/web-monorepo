{
  "name": "hugomeet-SS",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hugomeet-SS",
  "projectType": "application",
  "tags": [
    "backend"
  ],
  "implicitDependencies": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/hugomeet-SS/src/signallingServer.js"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pm2 startOrReload ecosystem.config.js --only HugoMeet-SS --update-env && pm2 save"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/hugomeet-SS/**/*"
        ]
      },
      "defaultConfiguration": "test",
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
