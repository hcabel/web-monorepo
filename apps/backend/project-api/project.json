{
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"name": "project-api",
	"sourceRoot": "apps/backend/project-api/src",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/apps/backend/project-api",
				"command": "rm -rf dist/apps/backend/project-api && tsc -p apps/backend/project-api/tsconfig.json --outDir dist/apps/backend/project-api"
			},
			"configurations": {
				"production": {
					"command": "rm -rf dist/apps/backend/project-api && tsc -p apps/backend/project-api/tsconfig.json --outDir dist/apps/backend/project-api"
				}
			}
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node -r ts-node/register apps/backend/project-api/src/server.ts"
			},
			"configurations": {
				"production": {
					"command": "node dist/apps/backend/project-api/server.js"
				}
			},
			"dependsOn": ["build"]
		},
		"lint": {
			"executor": "@nrwl/linter:eslint",
			"options": {
				"lintFilePatterns": ["apps/backend/project-api/src/**/*"]
			},
			"defaultConfiguration": "test",
			"configurations": {
				"fix": {
					"fix": true
				}
			}
		},
		"test": {
			"executor": "@nrwl/jest:jest",
			"outputs": ["coverage/apps/backend/project-api"],
			"options": {
				"jestConfig": "apps/backend/project-api/jest.config.ts",
				"passWithNoTests": true
			}
		}
	},
	"tags": ["backend"]
}
